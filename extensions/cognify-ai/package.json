{
  "name": "cognify-ai",
  "displayName": "%displayName%",
  "description": "%description%",
  "enabledApiProposals": [
    "languageModelCapabilities"
  ],
  "version": "0.1.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.139.0"
  },
  "main": "./out/extension",
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces%"
    }
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "cognify.roles",
        "name": "cognify",
        "fullName": "Cognify",
        "description": "%participant.description%",
        "welcomeMessage": "%participant.welcomeMessage%",
        "isSticky": false,
        "commands": [
          {
            "name": "review",
            "description": "%command.review.description%"
          },
          {
            "name": "explain",
            "description": "%command.explain.description%"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "cognify_projectModel",
        "toolReferenceName": "projectModel",
        "displayName": "%tool.projectModel.displayName%",
        "userDescription": "%tool.projectModel.userDescription%",
        "modelDescription": "Answers questions about how this workspace is structured, built, tested and shipped, from an index of its manifests, CI workflows and convention files (never file contents). Operations: 'summary' (packages, CI pipelines, conventions); 'package' (scripts, dependencies and entry points of the package containing `path`); 'howToTest' (how to build and test the package containing `path`, and which CI runs for it); 'ciFor' (which CI pipelines run on a change to `paths`, honoring their branch and path filters; pass `branch`, the push or pull-request target branch, when known); 'recentChanges' (commits since the integration branch, only those touching `path` when given, and uncommitted changes). `path` defaults to the active file. Answers cite evidence files and mark inferred facts.",
        "canBeReferencedInPrompt": true,
        "icon": "$(project)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": ["summary", "package", "howToTest", "ciFor", "recentChanges"],
              "description": "What to ask."
            },
            "path": {
              "type": "string",
              "description": "Workspace-relative file or folder, for 'package', 'howToTest', 'ciFor' and 'recentChanges'. Defaults to the active file, except for 'recentChanges', where it filters commits to that path."
            },
            "paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Workspace-relative paths for 'ciFor'."
            },
            "branch": {
              "type": "string",
              "description": "For 'howToTest' and 'ciFor': the branch the change is pushed to or targets (for example the pull request's base branch). Pipelines whose branch filters don't match are left out."
            }
          },
          "required": ["operation"]
        }
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "cognify",
        "displayName": "%languageModelChatProviders.displayName%"
      }
    ],
    "chatAgents": [
      {
        "path": "./agents/planner.agent.md"
      },
      {
        "path": "./agents/coder.agent.md"
      },
      {
        "path": "./agents/reviewer.agent.md"
      },
      {
        "path": "./agents/tester.agent.md"
      }
    ],
    "commands": [
      {
        "command": "cognify.ai.showAuditLog",
        "title": "%command.showAuditLog.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.checkSetup",
        "title": "%command.checkSetup.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.exportAuditLog",
        "title": "%command.exportAuditLog.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.clearAuditLog",
        "title": "%command.clearAuditLog.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.showProjectModel",
        "title": "%command.showProjectModel.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.rebuildProjectModel",
        "title": "%command.rebuildProjectModel.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.clearProjectModel",
        "title": "%command.clearProjectModel.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.explainRoute",
        "title": "%command.explainRoute.title%",
        "category": "Cognify"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "cognify.ai.preferredVendor": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%config.preferredVendor%",
          "examples": [
            "copilot",
            "openai",
            "gemini",
            "anthropic",
            "ollama"
          ]
        },
        "cognify.ai.pinnedModel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%config.pinnedModel%"
        },
        "cognify.ai.fallbackWhenPinned": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.fallbackWhenPinned%"
        },
        "cognify.ai.disabledVendors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.disabledVendors%"
        },
        "cognify.ai.trustedVendors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.trustedVendors%"
        },
        "cognify.ai.maxCostTier": {
          "type": "string",
          "enum": [
            "free",
            "included",
            "metered",
            "premium"
          ],
          "enumDescriptions": [
            "%config.maxCostTier.free%",
            "%config.maxCostTier.included%",
            "%config.maxCostTier.metered%",
            "%config.maxCostTier.premium%"
          ],
          "default": "premium",
          "scope": "application",
          "markdownDescription": "%config.maxCostTier%"
        },
        "cognify.privacy.localOnly": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.privacy.localOnly%"
        },
        "cognify.privacy.confidentialWorkspace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.privacy.confidentialWorkspace%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "cognify.ai.explainRoute",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.mjs compile-extension:cognify-ai ./tsconfig.json",
    "test": "node --test \"src/test/**/*.test.ts\"",
    "typecheck-test": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.test.json",
    "test-integration": "./test-integration.sh"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devartblake/cognify_ide.git"
  }
}
