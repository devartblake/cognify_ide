{
  "name": "cognify-ai",
  "displayName": "%displayName%",
  "description": "%description%",
  "enabledApiProposals": [
    "languageModelCapabilities"
  ],
  "version": "0.1.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.139.0"
  },
  "main": "./out/extension",
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces%"
    }
  },
  "contributes": {
    "configurationDefaults": {
      "chat.persistentProgress": "drawMonochromeNoIcon"
    },
    "chatParticipants": [
      {
        "id": "cognify.roles",
        "name": "cognify",
        "fullName": "Cognify",
        "description": "%participant.description%",
        "welcomeMessage": "%participant.welcomeMessage%",
        "isSticky": false,
        "commands": [
          {
            "name": "review",
            "description": "%command.review.description%"
          },
          {
            "name": "explain",
            "description": "%command.explain.description%"
          },
          {
            "name": "guide",
            "description": "%command.guide.description%"
          },
          {
            "name": "fix",
            "description": "%command.fix.description%"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "cognify_projectModel",
        "toolReferenceName": "projectModel",
        "displayName": "%tool.projectModel.displayName%",
        "userDescription": "%tool.projectModel.userDescription%",
        "modelDescription": "Answers questions about how this workspace is structured, built, tested and shipped, from an index of its manifests, CI workflows and convention files (never file contents). Operations: 'summary' (packages, CI pipelines, conventions); 'package' (scripts, dependencies and entry points of the package containing `path`); 'howToTest' (how to build and test the package containing `path`, and which CI runs for it; for a project created by Cognify, its template's commands and whether they run in its Dev Container); 'howToRun' (how to run the project or package containing `path`); 'ciFor' (which CI pipelines run on a change to `paths`, honoring their branch and path filters; pass `branch`, the push or pull-request target branch, when known); 'recentChanges' (commits since the integration branch, only those touching `path` when given, and uncommitted changes). `path` defaults to the active file. Answers cite evidence files and mark inferred facts.",
        "canBeReferencedInPrompt": true,
        "icon": "$(project)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": ["summary", "package", "howToTest", "howToRun", "ciFor", "recentChanges"],
              "description": "What to ask."
            },
            "path": {
              "type": "string",
              "description": "Workspace-relative file or folder, for 'package', 'howToTest', 'howToRun', 'ciFor' and 'recentChanges'. Defaults to the active file, except for 'recentChanges', where it filters commits to that path."
            },
            "paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Workspace-relative paths for 'ciFor'."
            },
            "branch": {
              "type": "string",
              "description": "For 'howToTest' and 'ciFor': the branch the change is pushed to or targets (for example the pull request's base branch). Pipelines whose branch filters don't match are left out."
            }
          },
          "required": ["operation"]
        }
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "cognify",
        "displayName": "%languageModelChatProviders.displayName%"
      }
    ],
    "chatAgents": [
      {
        "path": "./agents/planner.agent.md"
      },
      {
        "path": "./agents/coder.agent.md"
      },
      {
        "path": "./agents/reviewer.agent.md"
      },
      {
        "path": "./agents/tester.agent.md"
      }
    ],
    "commands": [
      {
        "command": "cognify.ai.showAuditLog",
        "title": "%command.showAuditLog.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.checkSetup",
        "title": "%command.checkSetup.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.newProject",
        "title": "%command.newProject.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.project.run",
        "title": "%command.project.run.title%",
        "category": "Cognify",
        "icon": "$(play)"
      },
      {
        "command": "cognify.project.stop",
        "title": "%command.project.stop.title%",
        "category": "Cognify",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cognify.project.openPreview",
        "title": "%command.project.openPreview.title%",
        "category": "Cognify",
        "icon": "$(globe)"
      },
      {
        "command": "cognify.explainSelection",
        "title": "%command.explainSelection.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.guideMe",
        "title": "%command.guideMe.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.fixDiagnostic",
        "title": "%command.fixDiagnostic.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.environment.check",
        "title": "%command.checkEnvironment.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.environment.run",
        "title": "%command.environment.run.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.environment.start",
        "title": "%command.environment.start.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.environment.stop",
        "title": "%command.environment.stop.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.environment.rebuild",
        "title": "%command.environment.rebuild.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.exportAuditLog",
        "title": "%command.exportAuditLog.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.clearAuditLog",
        "title": "%command.clearAuditLog.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.showProjectModel",
        "title": "%command.showProjectModel.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.rebuildProjectModel",
        "title": "%command.rebuildProjectModel.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.clearProjectModel",
        "title": "%command.clearProjectModel.title%",
        "category": "Cognify"
      },
      {
        "command": "cognify.ai.explainRoute",
        "title": "%command.explainRoute.title%",
        "category": "Cognify"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "cognify.ai.preferredVendor": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%config.preferredVendor%",
          "examples": [
            "copilot",
            "openai",
            "gemini",
            "anthropic",
            "ollama"
          ]
        },
        "cognify.ai.pinnedModel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%config.pinnedModel%"
        },
        "cognify.ai.fallbackWhenPinned": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.fallbackWhenPinned%"
        },
        "cognify.ai.disabledVendors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.disabledVendors%"
        },
        "cognify.ai.trustedVendors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.trustedVendors%"
        },
        "cognify.ai.maxCostTier": {
          "type": "string",
          "enum": [
            "free",
            "included",
            "metered",
            "premium"
          ],
          "enumDescriptions": [
            "%config.maxCostTier.free%",
            "%config.maxCostTier.included%",
            "%config.maxCostTier.metered%",
            "%config.maxCostTier.premium%"
          ],
          "default": "premium",
          "scope": "application",
          "markdownDescription": "%config.maxCostTier%"
        },
        "cognify.privacy.localOnly": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.privacy.localOnly%"
        },
        "cognify.privacy.confidentialWorkspace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.privacy.confidentialWorkspace%"
        },
        "cognify.projectModel.indexOnOpen": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%config.projectModel.indexOnOpen%"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "cognify",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "enum": ["install", "build", "test", "run"],
            "description": "%taskDefinition.command%"
          }
        },
        "when": "isWorkspaceTrusted"
      }
    ],
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "%viewsWelcome.explorer.newProject%",
        "when": "workbenchState == empty",
        "group": "2_cognify@1"
      }
    ],
    "walkthroughs": [
      {
        "id": "cognify.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "newProject",
            "title": "%walkthrough.newProject.title%",
            "description": "%walkthrough.newProject.description%",
            "media": { "markdown": "media/walkthrough/newProject.md" },
            "completionEvents": ["onCommand:cognify.newProject"]
          },
          {
            "id": "checkEnvironment",
            "title": "%walkthrough.checkEnvironment.title%",
            "description": "%walkthrough.checkEnvironment.description%",
            "media": { "markdown": "media/walkthrough/checkEnvironment.md" },
            "completionEvents": ["onCommand:cognify.environment.check"]
          },
          {
            "id": "checkAiSetup",
            "title": "%walkthrough.checkAiSetup.title%",
            "description": "%walkthrough.checkAiSetup.description%",
            "media": { "markdown": "media/walkthrough/checkAiSetup.md" },
            "completionEvents": ["onCommand:cognify.ai.checkSetup"]
          },
          {
            "id": "runProject",
            "title": "%walkthrough.runProject.title%",
            "description": "%walkthrough.runProject.description%",
            "media": { "markdown": "media/walkthrough/runProject.md" },
            "completionEvents": ["onCommand:cognify.project.run"]
          },
          {
            "id": "askCognify",
            "title": "%walkthrough.askCognify.title%",
            "description": "%walkthrough.askCognify.description%",
            "media": { "markdown": "media/walkthrough/askCognify.md" },
            "completionEvents": ["onCommand:cognify.guideMe"]
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cognify.project.run",
          "when": "cognify.hasProject && !cognify.projectRunning && isWorkspaceTrusted",
          "group": "navigation@-10"
        },
        {
          "command": "cognify.project.stop",
          "when": "cognify.projectRunning",
          "group": "navigation@-10"
        }
      ],
      "editor/context": [
        {
          "command": "cognify.explainSelection",
          "group": "1_cognify@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cognify.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "cognify.ai.explainRoute",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.mjs compile-extension:cognify-ai ./tsconfig.json",
    "test": "node --test \"src/test/**/*.test.ts\"",
    "typecheck-test": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.test.json",
    "test-integration": "./test-integration.sh"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devartblake/cognify_ide.git"
  }
}
