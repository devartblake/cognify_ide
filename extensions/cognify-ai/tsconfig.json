{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out",
		// Pure modules import each other with `.ts` so `node --test` can run them;
		// the build rewrites those imports to `.js`.
		"rewriteRelativeImportExtensions": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*",
		"../../src/vscode-dts/vscode.d.ts",
		"../../src/vscode-dts/vscode.proposed.languageModelCapabilities.d.ts"
	],
	"exclude": [
		"src/test/**"
	]
}
