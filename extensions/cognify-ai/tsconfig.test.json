{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		// The unit tests run as ES modules: Node detects the module syntax.
		// There is no `"type": "module"` marker, because the extensions
		// build copies non-TypeScript files from src/ into out/ (see
		// src/test/buildOutput.test.ts).
		"module": "esnext",
		"moduleResolution": "bundler"
	},
	"include": [
		"src/router.ts",
		"src/privacy.ts",
		"src/setup.ts",
		"src/audit.ts",
		"src/rolePrompts.ts",
		"src/projectModel/**/*",
		"src/environments/**/*",
		"src/test/**/*"
	],
	"exclude": []
}
